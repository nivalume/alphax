# qlib workflow generated by alphax
qlib_init:
    provider_uri: {{ provider_uri | tojson }}
    region: {{ region | tojson }}

market: &market {{ market | tojson }}
benchmark: &benchmark {{ benchmark | tojson }}

data_handler_config: &data_handler_config
    start_time: {{ segments.train[0] | tojson }}
    end_time: {{ segments.test[1] | tojson }}
    instruments: *market
    data_loader:
        class: qlib.data.dataset.loader.NestedDataLoader
        kwargs:
            dataloader_l:
                - class: qlib.data.dataset.loader.QlibDataLoader
                  kwargs:
                      config:
                          label: [{{ [label] | tojson }}, ["LABEL0"]]
                          feature: [{{ feature_expressions | tojson }}, {{ feature_names | tojson }}]
{% if factors_file %}
                - class: qlib.data.dataset.loader.StaticDataLoader
                  kwargs:
                      config: {{ factors_file | tojson }}
{% endif %}
    learn_processors:
        - class: DropnaLabel
        - class: CSZScoreNorm
          kwargs:
              fields_group: label

port_analysis_config: &port_analysis_config
    strategy:
        class: TopkDropoutStrategy
        module_path: qlib.contrib.strategy
        kwargs:
            signal: <PRED>
            topk: {{ backtest.topk }}
            n_drop: {{ backtest.n_drop }}
    backtest:
        start_time: {{ segments.test[0] | tojson }}
        end_time: {{ backtest_end | tojson }}
        account: {{ backtest.account }}
        benchmark: *benchmark
        exchange_kwargs: {{ exchange | tojson }}

task:
    model: {{ model | tojson }}
    dataset:
        class: DatasetH
        module_path: qlib.data.dataset
        kwargs:
            handler:
                class: DataHandlerLP
                module_path: qlib.data.dataset.handler
                kwargs: *data_handler_config
            segments:
                train: {{ segments.train | list | tojson }}
                valid: {{ segments.valid | list | tojson }}
                test: {{ segments.test | list | tojson }}
    record:
        - class: SignalRecord
          module_path: qlib.workflow.record_temp
          kwargs:
              model: <MODEL>
              dataset: <DATASET>
        - class: SigAnaRecord
          module_path: qlib.workflow.record_temp
          kwargs:
              ana_long_short: false
              ann_scaler: {{ ann_scaler }}
        - class: PortAnaRecord
          module_path: qlib.workflow.record_temp
          kwargs:
              config: *port_analysis_config
