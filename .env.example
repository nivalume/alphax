# alphax-agent 环境配置示例
#
# 用法：
#   cp .env.example .env
#   编辑 .env，至少填好 ALPHAX_AGENT_LLM__MODEL 和 API key（下面第一节）。
#   .env 已在 .gitignore 中，不会被提交。
#
# 规则：
#   1. 优先级（高 → 低）：shell 环境变量 > 当前目录的 .env > -c 指定的 YAML 运行文件 > 内置默认值。
#      所以 .env 里的值会覆盖 configs/qlib_factor.yaml 里的同名项。
#   2. .env 从运行命令时的当前目录读取，请在仓库根目录执行 alphax-agent。
#   3. 变量名 = ALPHAX_AGENT_ + 配置段 + __ + 字段，层级之间用双下划线，不区分大小写。
#        llm.model                               → ALPHAX_AGENT_LLM__MODEL
#        scenario.options.qlib.provider_uri      → ALPHAX_AGENT_SCENARIO__OPTIONS__QLIB__PROVIDER_URI
#   4. 数字、布尔值直接写（200、true）；字典和列表写成 JSON。引号可有可无。
#   5. 以 # 开头的配置行是可选项，给出的是默认值或示例值，去掉 # 才生效。
#      不需要改的项不用写，保持注释即可。
#   6. 注释请单独占一行，不要写在值的后面。

# ======================================================================
# 1. LLM（必填）
# ======================================================================

# 模型。任何 litellm 支持的模型 id，一般是 <服务商>/<模型名>。
#   deepseek/deepseek-chat    openai/gpt-4o    gpt-4o-mini
# 接 OpenAI 兼容网关时写 openai/<网关上的模型名>，并设置下面的 API_BASE。
ALPHAX_AGENT_LLM__MODEL=deepseek/deepseek-chat

# API key：取消注释并填入真实值。
# 不要写成空值（ALPHAX_AGENT_LLM__API_KEY=）。空字符串会被当作 key 发给服务商，
# 并盖掉你在 shell 里导出的 OPENAI_API_KEY 等变量。
# 如果你选择在 shell 里导出服务商自己的变量，就保持这一行注释。
# ALPHAX_AGENT_LLM__API_KEY=sk-xxxxxxxxxxxxxxxx

# 自定义网关或自建 OpenAI 兼容服务的地址。使用官方接口时不用设。
# ALPHAX_AGENT_LLM__API_BASE=https://my-gateway.example.com/v1

# ----------------------------------------------------------------------
# LLM 可选项
# ----------------------------------------------------------------------

# 采样温度。
# ALPHAX_AGENT_LLM__TEMPERATURE=0.2

# 单次回复的 token 上限。默认不限制。
# ALPHAX_AGENT_LLM__MAX_TOKENS=4096

# 单次请求超时，秒。
# ALPHAX_AGENT_LLM__TIMEOUT=180

# 限流、超时、5xx 等临时错误的重试次数。
# ALPHAX_AGENT_LLM__MAX_RETRIES=4

# 重试间隔按指数退避，这是底数，秒。
# ALPHAX_AGENT_LLM__RETRY_BACKOFF=2.0

# 模型支持时，要求它输出 JSON。
# ALPHAX_AGENT_LLM__JSON_MODE=true

# 响应缓存目录。设置后，相同请求直接读缓存，可以不调用 API 重放一次运行。默认关闭。
# ALPHAX_AGENT_LLM__CACHE_DIR=~/.alphax/agent/llm_cache

# 额外参数，JSON 对象，原样传给 litellm.completion。例如 Azure 的 api_version、top_p。
# ALPHAX_AGENT_LLM__EXTRA_PARAMS={"api_version": "2024-02-01"}

# ======================================================================
# 2. 研究循环与编码搜索（可选）
# ======================================================================
# 这些项平时写在 YAML 的 workflow、costeer 下。在这里设置会覆盖 YAML。

# 一次运行的轮数上限。命令行的 --loops 优先于它。
# ALPHAX_AGENT_WORKFLOW__MAX_LOOPS=20

# 连续失败多少轮后停止运行。
# ALPHAX_AGENT_WORKFLOW__MAX_CONSECUTIVE_FAILURES=3

# 运行目录的存放位置，每次运行在其下建一个子目录。
# ALPHAX_AGENT_WORKFLOW__RUN_ROOT=alphax_runs

# 编码搜索策略：ucb 或 greedy。
# ALPHAX_AGENT_COSTEER__POLICY=ucb

# 每个实验的搜索轮数。
# ALPHAX_AGENT_COSTEER__MAX_ROUNDS=5

# 同时实现的任务数。遇到 API 限流时调小。
# ALPHAX_AGENT_COSTEER__MAX_PARALLEL=3

# 经验库文件。设置后，经验在多次运行之间保留。
# ALPHAX_AGENT_COSTEER__LESSON_STORE=~/.alphax/agent/lessons/qlib_factor.json

# ======================================================================
# 3. 场景 qlib_factor（可选）
# ======================================================================
# 场景选项在 YAML 的 scenario.options 下。用 ALPHAX_AGENT_SCENARIO__OPTIONS__ 前缀逐项覆盖，
# 没有被覆盖的 YAML 项保持不变。

# qlib 数据目录。
# ALPHAX_AGENT_SCENARIO__OPTIONS__QLIB__PROVIDER_URI=~/.qlib/qlib_data/cn_data

# 装有 qlib 的 Python 解释器，请写绝对路径。默认用运行 alphax 的那个解释器。
# ALPHAX_AGENT_SCENARIO__OPTIONS__QLIB__PYTHON_BIN=/opt/qlib-env/bin/python

# 一次 qlib 回测的时间上限，秒。
# ALPHAX_AGENT_SCENARIO__OPTIONS__QLIB__TIMEOUT=3600

# 导出的行情数据（daily_pv.h5）的存放目录。
# ALPHAX_AGENT_SCENARIO__OPTIONS__DATA_DIR=~/.alphax/agent/data/qlib_factor

# 股票池和基准。
# ALPHAX_AGENT_SCENARIO__OPTIONS__MARKET=csi300
# ALPHAX_AGENT_SCENARIO__OPTIONS__BENCHMARK=SH000300

# 是否把 LLM 代码审查作为最后一个评估阶段。关闭后少一次 LLM 调用，但少一层检查。
# ALPHAX_AGENT_SCENARIO__OPTIONS__USE_CRITIC=true

# ======================================================================
# 4. 场景 crypto_strategy（可选）
# ======================================================================
# 选用这个场景时，YAML 的 scenario.name 写 crypto_strategy（见 configs/crypto_strategy.yaml）。

# 数据根目录：schema 在 schemas/ 下，行数据在 crypto/ 下。支持 ~ 和 $VAR。
# ALPHAX_AGENT_SCENARIO__OPTIONS__DATA_ROOT_DIR=~/jarvis-data

# 每个实验的策略数上限：一个机制及其变体。
# ALPHAX_AGENT_SCENARIO__OPTIONS__MAX_STRATEGIES_PER_EXPERIMENT=2

# ======================================================================
# 5. 服务商自己的环境变量（不要写在这个文件里）
# ======================================================================
# litellm 也认各服务商的原生变量，如 OPENAI_API_KEY、DEEPSEEK_API_KEY、ANTHROPIC_API_KEY、
# AZURE_API_BASE、AWS_REGION_NAME。请在 shell 里 export 它们：
#
#   export DEEPSEEK_API_KEY=sk-...
#
# alphax-agent 只读取 .env 里 ALPHAX_AGENT_ 开头的变量。写在 .env 里的其他变量不一定能传到 litellm：
# litellm 自己的 .env 查找只在它安装在 .env 所在目录之下时才生效（例如项目内的 .venv），
# 用全局环境或 conda 环境时读不到。只用一个 key 的话，直接用上面的 ALPHAX_AGENT_LLM__API_KEY 最省事。
