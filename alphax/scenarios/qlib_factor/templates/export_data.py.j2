"""Export qlib price-volume data for factor research. Generated by alphax."""

import json
from pathlib import Path

import qlib

qlib.init(provider_uri={{ provider_uri | tojson }}, region={{ region | tojson }})

from qlib.data import D  # noqa: E402

FILE_NAME = {{ file_name | tojson }}
KEY = {{ key | tojson }}

instruments = D.instruments({{ market | tojson }})
full = D.features(
    instruments,
    {{ fields | tojson }},
    start_time={{ start | tojson }},
    end_time={{ end | tojson }},
    freq="day",
)
full = full.swaplevel().sort_index()
full.index.names = ["datetime", "instrument"]
full = full.astype("float64")
if full.empty:
    raise SystemExit("qlib returned no data for the requested market and dates")

window = full.loc[{{ debug_start | tojson }}:{{ debug_end | tojson }}]
counts = window.groupby(level="instrument").size().sort_values(ascending=False, kind="stable")
selected = set(counts.index[: {{ debug_instruments }}])
debug = window[window.index.get_level_values("instrument").isin(selected)]
dates = debug.index.get_level_values("datetime").unique().sort_values()
cut_date = dates[int(len(dates) * {{ cut_fraction }})]
debug_cut = debug.loc[:cut_date]

for variant, frame in (("full", full), ("debug", debug), ("debug_cut", debug_cut)):
    Path(variant).mkdir(exist_ok=True)
    frame.to_hdf(Path(variant) / FILE_NAME, key=KEY, mode="w")

meta = {
    "market": {{ market | tojson }},
    "fields": list(full.columns),
    "full_rows": int(len(full)),
    "full_start": str(full.index.get_level_values("datetime").min().date()),
    "full_end": str(full.index.get_level_values("datetime").max().date()),
    "full_instruments": int(full.index.get_level_values("instrument").nunique()),
    "debug_rows": int(len(debug)),
    "debug_instruments": int(len(selected)),
    "debug_start": str(dates[0].date()),
    "debug_end": str(dates[-1].date()),
    "cut_date": str(cut_date.date()),
}
Path("meta.json").write_text(json.dumps(meta, indent=2))
print(json.dumps(meta))
