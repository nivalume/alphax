"""Export the metrics of the latest finished qlib recorder. Generated by alphax."""

import json
import math
from pathlib import Path

import qlib

qlib.init(
    provider_uri={{ provider_uri | tojson }},
    region={{ region | tojson }},
    exp_manager={
        "class": "MLflowExpManager",
        "module_path": "qlib.workflow.expm",
        "kwargs": {"uri": "file:" + str(Path({{ uri_folder | tojson }}).resolve()), "default_exp_name": "Experiment"},
    },
)

from qlib.workflow import R  # noqa: E402

recorders = R.list_recorders(experiment_name={{ experiment_name | tojson }})
finished = [recorder for recorder in recorders.values() if recorder.info.get("end_time")]
if not finished:
    raise SystemExit("no finished recorder found")
latest = max(finished, key=lambda recorder: str(recorder.info["end_time"]))

metrics = {}
for name, value in latest.list_metrics().items():
    value = float(value)
    if math.isfinite(value):
        metrics[name] = value

try:
    report = latest.load_object("portfolio_analysis/report_normal_1day.pkl")
    report.to_parquet({{ report_file | tojson }})
except Exception as exc:  # the backtest record is optional
    print(f"portfolio report unavailable: {exc}")

Path({{ metrics_file | tojson }}).write_text(json.dumps(metrics, indent=2, sort_keys=True))
print(f"exported {len(metrics)} metrics from recorder {latest.id}")
